PORT=5000
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
JWT_SECRET=

# MAVIO GLOBAL GST pricing defaults. GSTIN/address belong in protected
# production configuration, not browser code or workflow exports.
DEFAULT_CURRENCY=INR
DEFAULT_GST_RATE=18
GST_LEGAL_NAME=
GSTIN=
GST_REGISTERED_ADDRESS=

# Restricted n8n and signed outbound-event credentials.
N8N_SERVICE_TOKEN=
N8N_WHATSAPP_WEBHOOK_URL=
N8N_WEBHOOK_SIGNING_SECRET=

# Secure website page that consumes the enquiry/upload_token query parameters.
WEBSITE_APPLICATION_URL=

# Meta WhatsApp Flow data-exchange configuration.
META_APP_SECRET=
META_FLOW_PRIVATE_KEY=
META_FLOW_PRIVATE_KEY_PASSPHRASE=

# Required for OTP-free, server-side application contact validation.
# Check-Mail checks invalid/disposable email addresses.
CHECK_MAIL_API_KEY=

# Direct Meta WhatsApp Cloud API configuration (without n8n)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_CLOUD_API_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v21.0

# WhatsApp Webhook Durable Inbox Background Worker (defaults to disabled)
ENABLE_WHATSAPP_INBOX_WORKER=false
WORKER_ID=
WORKER_POLL_INTERVAL_MS=3000
WORKER_LEASE_MINUTES=5
WORKER_MAX_RETRIES=5
