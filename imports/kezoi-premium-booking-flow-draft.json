        "quote_generated_at": { "type": "string", "__example__": "2026-10-14T12:00:00.000Z" },
        "has_special_requests": { "type": "boolean", "__example__": false },
        "has_error": { "type": "boolean", "__example__": false },
        "error_message": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "${data.property_name}" },
          { "type": "TextSubheading", "text": "Stay details" },
          { "type": "TextBody", "text": "${data.check_in} to ${data.check_out}\nAdults: ${data.adults} • Children: ${data.children} • Infants: ${data.infants} • Pets: ${data.pets}" },
          { "type": "TextSubheading", "text": "Guest contact" },
          { "type": "TextBody", "text": "Name: ${data.guest_name}\nEmail: ${data.guest_email}\nWhatsApp: ${data.whatsapp_number}\nCountry code: ${data.country_code}" },
          { "type": "TextBody", "text": "Special requests: ${data.special_requests}", "visible": "${data.has_special_requests}" },
          { "type": "TextSubheading", "text": "Quotation summary" },
          { "type": "TextBody", "text": "Stay (${data.quote.nights} nights): ${data.quote.currency} ${data.quote.base_amount}\nExtra guests: ${data.quote.currency} ${data.quote.extra_guest_amount}\nTaxable amount: ${data.quote.currency} ${data.quote.taxable_amount}\nGST (${data.quote.gst_rate}%): ${data.quote.currency} ${data.quote.gst_amount} (CGST: ${data.quote.currency} ${data.quote.cgst_amount} + SGST: ${data.quote.currency} ${data.quote.sgst_amount})" },
          { "type": "TextHeading", "text": "Total: ${data.quote.currency} ${data.quote.total_amount}" },
          { "type": "TextCaption", "text": "Submitting creates a pending enquiry only. No payment is taken and no reservation is confirmed until approved." },
          { "type": "TextBody", "text": "${data.error_message}", "visible": "${data.has_error}" },
          {
            "type": "Footer",
            "label": "Confirm & create enquiry",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "property_id": "${data.property_id}",
                "check_in": "${data.check_in}",
                "check_out": "${data.check_out}",
                "adults": "${data.adults}",
                "children": "${data.children}",
                "infants": "${data.infants}",
                "pets": "${data.pets}",
                "guest_name": "${data.guest_name}",
                "guest_email": "${data.guest_email}",
                "whatsapp_number": "${data.whatsapp_number}",
                "country_code": "${data.country_code}",
                "special_requests": "${data.special_requests}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "ENQUIRY_CREATED",
      "title": "Enquiry created",
      "terminal": true,
      "success": true,
      "data": {
        "enquiry_reference": { "type": "string", "__example__": "APP-42" },
        "enquiry_status": { "type": "string", "__example__": "NEW" },
        "payment_status": { "type": "string", "__example__": "NOT_STARTED" },
        "continuation_type": { "type": "string", "__example__": "IDENTITY_DOCUMENT_UPLOAD" },
        "continuation_url": { "type": "string", "__example__": "https://www.kezoistays.com/application" },
        "replayed": { "type": "boolean", "__example__": false },
        "message": { "type": "string", "__example__": "Enquiry created. No booking or payment has been confirmed." }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Enquiry ${data.enquiry_reference}" },
          { "type": "TextBody", "text": "${data.message}" },
          { "type": "TextBody", "text": "Enquiry status: ${data.enquiry_status}\nPayment status: ${data.payment_status}" },
          {
            "type": "EmbeddedLink",
            "text": "Upload identity document",
            "on-click-action": {
              "name": "open_url",
              "url": "${data.continuation_url}"
            }
          },
          { "type": "TextCaption", "text": "Complete your identity verification using the secure link above. Our team will review your enquiry and contact you on WhatsApp." },
          {
            "type": "Footer",
            "label": "Done",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "enquiry_reference": "${data.enquiry_reference}",
                "enquiry_status": "${data.enquiry_status}",
                "payment_status": "${data.payment_status}"
              }
            }
          }
        ]
      }
    }
  ]
}
