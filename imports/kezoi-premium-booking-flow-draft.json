        "property_description": { "type": "string", "__example__": "Experience unparalleled luxury in the heart of Hyderabad. Our residence offers a seamless blend of elegant design, modern amenities, and personalized service." },
        "property_location": { "type": "string", "__example__": "Manikonda, Hyderabad" },
        "amenities": { "type": "array", "items": { "type": "string" }, "__example__": ["Wi-Fi", "Kitchen", "Air conditioning", "Washer", "Free parking on premises", "Elevator"] },
        "amenities_text": { "type": "string", "__example__": "Wi-Fi • Kitchen • Air conditioning • Washer • Free parking on premises • Elevator" },
        "max_guests": { "type": "number", "__example__": 8 },
        "max_guests_text": { "type": "string", "__example__": "Accommodates up to 8 guests" },
        "gallery": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "src": { "type": "string" },
              "alt-text": { "type": "string" }
            }
          },
          "__example__": [{ "src": "iVBORw0KGgo=", "alt-text": "Living room" }]
        },
        "has_gallery": { "type": "boolean", "__example__": true },
        "check_in": { "type": "string", "__example__": "2026-11-01" },
        "check_out": { "type": "string", "__example__": "2026-11-03" },
        "adults": { "type": "number", "__example__": 2 },
        "children": { "type": "number", "__example__": 0 },
        "infants": { "type": "number", "__example__": 0 },
        "pets": { "type": "number", "__example__": 0 },
        "has_error": { "type": "boolean", "__example__": false },
        "error_message": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "ImageCarousel", "images": "${data.gallery}", "aspect-ratio": "4:3", "scale-type": "cover", "visible": "${data.has_gallery}" },
          { "type": "TextHeading", "text": "${data.property_name}" },
          { "type": "TextSubheading", "text": "${data.property_specs_text}" },
          { "type": "TextBody", "text": "${data.property_description}" },
          { "type": "TextSubheading", "text": "Location" },
          { "type": "TextBody", "text": "${data.property_location}" },
          { "type": "TextSubheading", "text": "Amenities & facilities" },
          { "type": "TextBody", "text": "${data.amenities_text}" },
          { "type": "TextCaption", "text": "${data.max_guests_text}" },
          { "type": "TextBody", "text": "${data.error_message}", "visible": "${data.has_error}" },
          {
            "type": "Footer",
            "label": "Reserve",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "property_id": "${data.property_id}",
                "check_in": "${data.check_in}",
                "check_out": "${data.check_out}",
                "adults": "${data.adults}",
                "children": "${data.children}",
                "infants": "${data.infants}",
                "pets": "${data.pets}"
              }
            }
          }
        ]
      }
    },
