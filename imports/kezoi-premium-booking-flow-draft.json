        "check_out": { "type": "string", "__example__": "2026-11-03" },
        "max_guests": { "type": "number", "__example__": 10 },
        "adults": { "type": "number", "__example__": 2 },
        "children": { "type": "number", "__example__": 0 },
        "infants": { "type": "number", "__example__": 0 },
        "pets": { "type": "number", "__example__": 0 },
        "has_error": { "type": "boolean", "__example__": false },
        "error_message": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "guest_selection_form",
            "init-values": {
              "adults": "${data.adults}",
              "children": "${data.children}",
              "infants": "${data.infants}",
              "pets": "${data.pets}"
            },
            "children": [
              { "type": "TextBody", "text": "This property accommodates up to ${data.max_guests} guests." },
              { "type": "TextBody", "text": "${data.error_message}", "visible": "${data.has_error}" },
              { "type": "TextInput", "name": "adults", "label": "Adults", "input-type": "number", "required": true, "helper-text": "Minimum 1 adult" },
              { "type": "TextInput", "name": "children", "label": "Children", "input-type": "number", "required": false, "helper-text": "Ages 2–12" },
              { "type": "TextInput", "name": "infants", "label": "Infants", "input-type": "number", "required": false, "helper-text": "Under 2" },
              { "type": "TextInput", "name": "pets", "label": "Pets", "input-type": "number", "required": false, "helper-text": "Service / companion pets" },
