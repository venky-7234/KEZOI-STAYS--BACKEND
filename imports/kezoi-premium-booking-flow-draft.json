            "original_amount": { "type": "number" },
            "taxable_amount": { "type": "number" },
            "gst_rate": { "type": "number" },
            "cgst_amount": { "type": "number" },
            "sgst_amount": { "type": "number" },
            "gst_amount": { "type": "number" },
            "total_amount": { "type": "number" }
          },
          "__example__": {
            "currency": "INR",
            "nights": 2,
            "base_amount": 19998,
            "extra_guests": 0,
            "extra_guest_amount": 0,
            "original_amount": 19998,
            "taxable_amount": 19998,
            "gst_rate": 18,
            "cgst_amount": 1799.82,
            "sgst_amount": 1799.82,
            "gst_amount": 3599.64,
            "total_amount": 23597.64
          }
        },
        "quote_generated_at": { "type": "string", "__example__": "2026-10-14T12:00:00.000Z" },
        "has_special_requests": { "type": "boolean", "__example__": false },
        "stay_details_text": { "type": "string", "__example__": "Dates: 2026-11-01 to 2026-11-03\nAdults: 2 • Children: 0 • Infants: 0 • Pets: 0" },
        "guest_contact_text": { "type": "string", "__example__": "Name: Test Guest\nEmail: guest@example.com\nWhatsApp: +919876543210\nCountry code: IN" },
        "special_requests_text": { "type": "string", "__example__": "Special requests: High floor" },
        "quote_summary_text": { "type": "string", "__example__": "Stay (2 nights): INR 19998\nExtra guests: INR 0\nTaxable amount: INR 19998\nGST (18%): INR 3599.64 (CGST: INR 1799.82 + SGST: INR 1799.82)" },
        "total_amount_text": { "type": "string", "__example__": "Total: INR 23597.64" },
        "has_error": { "type": "boolean", "__example__": false },
        "error_message": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "${data.property_name}" },
          { "type": "TextSubheading", "text": "Stay details" },
          { "type": "TextBody", "text": "${data.stay_details_text}" },
          { "type": "TextSubheading", "text": "Guest contact" },
          { "type": "TextBody", "text": "${data.guest_contact_text}" },
          { "type": "TextBody", "text": "${data.special_requests_text}", "visible": "${data.has_special_requests}" },
          { "type": "TextSubheading", "text": "Quotation summary" },
          { "type": "TextBody", "text": "${data.quote_summary_text}" },
          { "type": "TextHeading", "text": "${data.total_amount_text}" },
          { "type": "TextCaption", "text": "Submitting creates a pending enquiry only. No payment is taken and no reservation is confirmed until approved." },
          { "type": "TextBody", "text": "${data.error_message}", "visible": "${data.has_error}" },
          {
            "type": "Footer",
            "label": "Confirm & create enquiry",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "property_id": "${data.property_id}",
                "check_in": "${data.check_in}",
                "check_out": "${data.check_out}",
                "adults": "${data.adults}",
                "children": "${data.children}",
                "infants": "${data.infants}",
                "pets": "${data.pets}",
                "guest_name": "${data.guest_name}",
                "guest_email": "${data.guest_email}",
                "whatsapp_number": "${data.whatsapp_number}",
                "country_code": "${data.country_code}",
                "special_requests": "${data.special_requests}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "ENQUIRY_CREATED",
      "title": "Enquiry created",
      "terminal": true,
      "success": true,
      "data": {
        "enquiry_reference": { "type": "string", "__example__": "APP-42" },
        "enquiry_reference_text": { "type": "string", "__example__": "Enquiry APP-42" },
        "enquiry_status": { "type": "string", "__example__": "NEW" },
        "payment_status": { "type": "string", "__example__": "NOT_STARTED" },
        "enquiry_status_text": { "type": "string", "__example__": "Enquiry status: NEW\nPayment status: NOT_STARTED" },
        "continuation_type": { "type": "string", "__example__": "IDENTITY_DOCUMENT_UPLOAD" },
        "continuation_url": { "type": "string", "__example__": "https://www.kezoistays.com/application" },
        "replayed": { "type": "boolean", "__example__": false },
        "message": { "type": "string", "__example__": "Enquiry created. No booking or payment has been confirmed." }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "${data.enquiry_reference_text}" },
          { "type": "TextBody", "text": "${data.message}" },
          { "type": "TextBody", "text": "${data.enquiry_status_text}" },
          {
            "type": "EmbeddedLink",
            "text": "Upload identity document",
            "on-click-action": {
              "name": "open_url",
              "url": "${data.continuation_url}"
            }
          },
          { "type": "TextCaption", "text": "Complete your identity verification using the secure link above. Our team will review your enquiry and contact you on WhatsApp." },
          {
            "type": "Footer",
            "label": "Done",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "enquiry_reference": "${data.enquiry_reference}",
                "enquiry_status": "${data.enquiry_status}",
                "payment_status": "${data.payment_status}"
              }
            }
          }
        ]
      }
    }
  ]
}
