{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "VIEW_STAY_ENTRY": ["VIEW_STAY_ENTRY", "PROPERTY_DETAILS"],
    "RESERVE_ENTRY": ["RESERVE_ENTRY", "CALENDAR"],
    "BOOKING_DETAILS": ["BOOKING_DETAILS", "PROPERTY_SELECTION"],
    "PROPERTY_SELECTION": ["PROPERTY_SELECTION", "PROPERTY_DETAILS"],
    "PROPERTY_DETAILS": ["PROPERTY_DETAILS", "CALENDAR"],
    "CALENDAR": ["CALENDAR", "GUEST_SELECTION"],
    "GUEST_SELECTION": ["GUEST_SELECTION", "LIVE_QUOTE"],
    "LIVE_QUOTE": ["LIVE_QUOTE", "GUEST_DETAILS"],
    "GUEST_DETAILS": ["GUEST_DETAILS", "BOOKING_REVIEW"],
    "BOOKING_REVIEW": ["BOOKING_REVIEW", "ENQUIRY_CREATED"],
    "ENQUIRY_CREATED": []
  },
  "screens": [
    {
      "id": "VIEW_STAY_ENTRY",
      "title": "View stay",
      "data": {
        "property_id": { "type": "string", "__example__": "1" },
        "property_code": { "type": "string", "__example__": "TG-0001" },
        "entry_intent": { "type": "string", "__example__": "view_stay" },
        "has_error": { "type": "boolean", "__example__": false },
        "error_message": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Kezoi Stays" },
          { "type": "TextBody", "text": "Load current property photographs, details and amenities." },
          { "type": "TextBody", "text": "${data.error_message}", "visible": "${data.has_error}" },
          {
            "type": "Footer",
            "label": "View property",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "property_id": "${data.property_id}",
                "property_code": "${data.property_code}",
                "entry_intent": "view_stay"
              }
            }
          }
        ]
      }
    },
    {
      "id": "RESERVE_ENTRY",
      "title": "Reserve your stay",
      "data": {
        "property_id": { "type": "string", "__example__": "1" },
        "property_code": { "type": "string", "__example__": "TG-0001" },
        "entry_intent": { "type": "string", "__example__": "reserve" },
        "has_error": { "type": "boolean", "__example__": false },
        "error_message": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Reserve Kezoi Stays" },
          { "type": "TextBody", "text": "Continue to the live availability calendar for the selected property." },
          { "type": "TextBody", "text": "${data.error_message}", "visible": "${data.has_error}" },
          {
            "type": "Footer",
            "label": "Select dates",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "property_id": "${data.property_id}",
                "property_code": "${data.property_code}",
                "entry_intent": "reserve"
              }
            }
          }
        ]
      }
    },
    {
      "id": "BOOKING_DETAILS",
      "title": "Explore Kezoi Stays",
      "data": {
        "has_error": { "type": "boolean", "__example__": false },
        "error_message": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "booking_details_form",
            "init-values": {
              "guests": 2,
              "children": 0,
              "infants": 0,
              "pets": 0
            },
            "children": [
              { "type": "TextHeading", "text": "Find your perfect stay" },
              { "type": "TextBody", "text": "Choose dates and party size. Availability and prices are checked live." },
              { "type": "TextBody", "text": "${data.error_message}", "visible": "${data.has_error}" },
              {
                "type": "CalendarPicker",
                "name": "stay_dates",
                "label": {
                  "start-date": "Check-in",
                  "end-date": "Check-out"
                },
                "helper-text": {
                  "start-date": "Select check-in date",
                  "end-date": "Select check-out date (exclusive)"
                },
                "mode": "range",
                "required": {
                  "start-date": true,
                  "end-date": true
                }
              },
              { "type": "TextInput", "name": "guests", "label": "Adults", "input-type": "number", "required": true, "helper-text": "Minimum 1 adult" },
              { "type": "TextInput", "name": "children", "label": "Children", "input-type": "number", "required": false, "helper-text": "Ages 2–12 (optional)" },
              { "type": "TextInput", "name": "infants", "label": "Infants", "input-type": "number", "required": false, "helper-text": "Under 2 (optional)" },
              { "type": "TextInput", "name": "pets", "label": "Pets", "input-type": "number", "required": false, "helper-text": "Service / companion pets (optional)" },
              {
                "type": "Footer",
                "label": "Explore properties",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "stay_dates": "${form.stay_dates}",
                    "guests": "${form.guests}",
                    "adults": "${form.guests}",
                    "children": "${form.children}",
                    "infants": "${form.infants}",
                    "pets": "${form.pets}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "PROPERTY_SELECTION",
      "title": "Available properties",
      "data": {
        "check_in": { "type": "string", "__example__": "2026-11-01" },
        "check_out": { "type": "string", "__example__": "2026-11-03" },
        "adults": { "type": "number", "__example__": 2 },
        "children": { "type": "number", "__example__": 0 },
        "infants": { "type": "number", "__example__": 0 },
        "pets": { "type": "number", "__example__": 0 },
        "properties": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "1", "title": "Kezoi Stays Manikonda", "description": "3 bedrooms | 3 bathrooms | INR 23598" }
          ]
        },
        "no_properties_available": { "type": "boolean", "__example__": false },
        "has_error": { "type": "boolean", "__example__": false },
        "quote_generated_at": { "type": "string", "__example__": "2026-10-14T12:00:00.000Z" },
        "error_message": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "property_selection_form",
            "children": [
              { "type": "TextHeading", "text": "Choose a property" },
              { "type": "TextBody", "text": "Live results for ${data.check_in} to ${data.check_out}." },
              { "type": "TextBody", "text": "No property is available for those dates and guests.", "visible": "${data.no_properties_available}" },
              { "type": "TextBody", "text": "${data.error_message}", "visible": "${data.has_error}" },
              { "type": "RadioButtonsGroup", "name": "property_id", "label": "Properties", "data-source": "${data.properties}", "required": true },
              {
                "type": "Footer",
                "label": "View stay",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "property_id": "${form.property_id}",
                    "check_in": "${data.check_in}",
                    "check_out": "${data.check_out}",
                    "adults": "${data.adults}",
                    "children": "${data.children}",
                    "infants": "${data.infants}",
                    "pets": "${data.pets}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "PROPERTY_DETAILS",
      "title": "Property details",
      "data": {
        "property_id": { "type": "string", "__example__": "1" },
        "property_name": { "type": "string", "__example__": "Kezoi Stays Manikonda" },
        "property_description": { "type": "string", "__example__": "A premium Kezoi stay." },
        "property_location": { "type": "string", "__example__": "Manikonda, Hyderabad" },
        "amenities": { "type": "array", "items": { "type": "string" }, "__example__": ["Wi-Fi", "Kitchen"] },
        "amenities_text": { "type": "string", "__example__": "Wi-Fi • Kitchen" },
        "max_guests": { "type": "number", "__example__": 10 },
        "gallery": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "src": { "type": "string" },
              "alt-text": { "type": "string" }
            }
          },
          "__example__": [{ "src": "iVBORw0KGgo=", "alt-text": "Living room" }]
        },
        "check_in": { "type": "string", "__example__": "2026-11-01" },
        "check_out": { "type": "string", "__example__": "2026-11-03" },
        "adults": { "type": "number", "__example__": 2 },
        "children": { "type": "number", "__example__": 0 },
        "infants": { "type": "number", "__example__": 0 },
        "pets": { "type": "number", "__example__": 0 },
        "has_error": { "type": "boolean", "__example__": false },
        "error_message": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "ImageCarousel", "images": "${data.gallery}", "aspect-ratio": "4:3", "scale-type": "cover" },
          { "type": "TextHeading", "text": "${data.property_name}" },
          { "type": "TextBody", "text": "${data.property_description}" },
          { "type": "TextSubheading", "text": "Location" },
          { "type": "TextBody", "text": "${data.property_location}" },
          { "type": "TextSubheading", "text": "Amenities & facilities" },
          { "type": "TextBody", "text": "${data.amenities_text}" },
          { "type": "TextCaption", "text": "Up to ${data.max_guests} guests" },
          { "type": "TextBody", "text": "${data.error_message}", "visible": "${data.has_error}" },
          {
            "type": "Footer",
            "label": "Reserve",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "property_id": "${data.property_id}",
                "check_in": "${data.check_in}",
                "check_out": "${data.check_out}",
                "adults": "${data.adults}",
                "children": "${data.children}",
                "infants": "${data.infants}",
                "pets": "${data.pets}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "CALENDAR",
      "title": "Select dates",
      "data": {
        "property_id": { "type": "string", "__example__": "1" },
        "check_in": { "type": "string", "__example__": "2026-11-01" },
        "check_out": { "type": "string", "__example__": "2026-11-03" },
        "adults": { "type": "number", "__example__": 2 },
        "children": { "type": "number", "__example__": 0 },
        "infants": { "type": "number", "__example__": 0 },
        "pets": { "type": "number", "__example__": 0 },
        "unavailable_dates": { "type": "array", "items": { "type": "string" }, "__example__": ["2026-11-10"] },
        "calendar_refreshed_at": { "type": "string", "__example__": "2026-10-14T12:00:00.000Z" },
        "has_error": { "type": "boolean", "__example__": false },
        "error_message": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "calendar_form",
            "children": [
              { "type": "TextBody", "text": "Unavailable nights are disabled from live booking data." },
              { "type": "TextBody", "text": "${data.error_message}", "visible": "${data.has_error}" },
              {
                "type": "CalendarPicker",
                "name": "stay_dates",
                "label": {
                  "start-date": "Check-in",
                  "end-date": "Check-out"
                },
                "helper-text": {
                  "start-date": "Select check-in date",
                  "end-date": "Select check-out date (exclusive)"
                },
                "mode": "range",
                "unavailable-dates": "${data.unavailable_dates}",
                "required": {
                  "start-date": true,
                  "end-date": true
                }
              },
              {
                "type": "Footer",
                "label": "Select guests",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "property_id": "${data.property_id}",
                    "stay_dates": "${form.stay_dates}",
                    "check_in": "${data.check_in}",
                    "check_out": "${data.check_out}",
                    "adults": "${data.adults}",
                    "children": "${data.children}",
                    "infants": "${data.infants}",
                    "pets": "${data.pets}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "GUEST_SELECTION",
      "title": "Guests",
