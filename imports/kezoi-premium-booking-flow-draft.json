{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "VIEW_STAY_ENTRY": ["PROPERTY_SELECTION", "PROPERTY_DETAILS"],
    "RESERVE_ENTRY": ["BOOKING_DETAILS", "CALENDAR"],
    "BOOKING_DETAILS": ["PROPERTY_SELECTION"],
    "PROPERTY_SELECTION": ["PROPERTY_DETAILS"],
    "PROPERTY_DETAILS": ["CALENDAR"],
    "CALENDAR": ["GUEST_SELECTION"],
    "GUEST_SELECTION": ["LIVE_QUOTE"],
    "LIVE_QUOTE": ["GUEST_DETAILS"],
    "GUEST_DETAILS": ["BOOKING_REVIEW"],
    "BOOKING_REVIEW": ["ENQUIRY_CREATED"],
    "ENQUIRY_CREATED": []
  },
  "screens": [
    {
      "id": "VIEW_STAY_ENTRY",
      "title": "View stay",
      "data": {
        "property_id": { "type": "string", "__example__": "1" },
        "property_code": { "type": "string", "__example__": "TG-0001" },
        "entry_intent": { "type": "string", "__example__": "view_stay" },
        "has_error": { "type": "boolean", "__example__": false },
        "error_message": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Kezoi Stays" },
          { "type": "TextBody", "text": "Discover our handpicked luxury villas and apartments in Hyderabad. Browse verified photographs, curated amenities, and premium spaces designed for comfort." },
          { "type": "TextBody", "text": "${data.error_message}", "visible": "${data.has_error}" },
          {
            "type": "Footer",
            "label": "Explore properties",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "entry_intent": "view_stay"
              }
            }
          }
        ]
      }
    },
    {
      "id": "RESERVE_ENTRY",
      "title": "Reserve your stay",
      "data": {
        "property_id": { "type": "string", "__example__": "1" },
        "property_code": { "type": "string", "__example__": "TG-0001" },
        "entry_intent": { "type": "string", "__example__": "reserve" },
        "has_error": { "type": "boolean", "__example__": false },
        "error_message": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Check Availability & Rates" },
          { "type": "TextBody", "text": "Select your desired stay dates and party size to check live availability and receive an instant transparent quotation. Every enquiry is verified before confirmation." },
          { "type": "TextBody", "text": "${data.error_message}", "visible": "${data.has_error}" },
          {
            "type": "Footer",
            "label": "Select dates",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "entry_intent": "reserve"
              }
            }
          }
        ]
      }
    },
    {
      "id": "BOOKING_DETAILS",
      "title": "Explore Kezoi Stays",
      "data": {
        "has_error": { "type": "boolean", "__example__": false },
        "error_message": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "booking_details_form",
            "init-values": {
              "guests": 2,
              "children": 0,
              "infants": 0,
              "pets": 0
            },
            "children": [
              { "type": "TextHeading", "text": "Find your perfect stay" },
              { "type": "TextBody", "text": "Choose dates and party size. Availability and prices are checked live." },
              { "type": "TextBody", "text": "${data.error_message}", "visible": "${data.has_error}" },
              {
                "type": "CalendarPicker",
                "name": "stay_dates",
                "label": {
                  "start-date": "Check-in",
                  "end-date": "Check-out"
                },
                "helper-text": {
                  "start-date": "Select check-in date",
                  "end-date": "Select check-out date (exclusive)"
                },
                "mode": "range",
                "required": {
                  "start-date": true,
                  "end-date": true
                }
              },
              { "type": "TextInput", "name": "guests", "label": "Adults", "input-type": "number", "required": true, "helper-text": "Minimum 1 adult" },
              { "type": "TextInput", "name": "children", "label": "Children", "input-type": "number", "required": false, "helper-text": "Ages 2–12 (optional)" },
              { "type": "TextInput", "name": "infants", "label": "Infants", "input-type": "number", "required": false, "helper-text": "Under 2 (optional)" },
              { "type": "TextInput", "name": "pets", "label": "Pets", "input-type": "number", "required": false, "helper-text": "Service / companion pets (optional)" },
              {
                "type": "Footer",
                "label": "Explore properties",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "stay_dates": "${form.stay_dates}",
                    "guests": "${form.guests}",
                    "adults": "${form.guests}",
                    "children": "${form.children}",
                    "infants": "${form.infants}",
                    "pets": "${form.pets}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "PROPERTY_SELECTION",
      "title": "Available properties",
      "data": {
        "check_in": { "type": "string", "__example__": "2026-11-01" },
        "check_out": { "type": "string", "__example__": "2026-11-03" },
        "adults": { "type": "number", "__example__": 2 },
        "children": { "type": "number", "__example__": 0 },
        "infants": { "type": "number", "__example__": 0 },
        "pets": { "type": "number", "__example__": 0 },
        "properties": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "1", "title": "Kezoi Stays Manikonda", "description": "Manikonda | 3 bedrooms • 3 bathrooms • Up to 8 guests | From INR 10000/night" },
            { "id": "2", "title": "Kezoi Penthouse Gachibowli", "description": "Gachibowli | 4 bedrooms • 4 bathrooms • Up to 12 guests | From INR 16000/night" }
          ]
        },
        "no_properties_available": { "type": "boolean", "__example__": false },
        "has_available_properties": { "type": "boolean", "__example__": true },
        "search_summary_text": { "type": "string", "__example__": "Live results for 2026-11-01 to 2026-11-03." },
        "has_error": { "type": "boolean", "__example__": false },
        "quote_generated_at": { "type": "string", "__example__": "2026-10-14T12:00:00.000Z" },
        "error_message": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "property_selection_form",
            "children": [
              { "type": "TextHeading", "text": "Choose a property" },
              { "type": "TextBody", "text": "${data.search_summary_text}" },
              { "type": "TextBody", "text": "No properties are available for the selected dates and guest count. Please select different dates.", "visible": "${data.no_properties_available}" },
              { "type": "TextBody", "text": "${data.error_message}", "visible": "${data.has_error}" },
              { "type": "RadioButtonsGroup", "name": "property_id", "label": "Properties", "data-source": "${data.properties}", "required": true, "visible": "${data.has_available_properties}" },
              {
                "type": "Footer",
                "label": "View stay",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "property_id": "${form.property_id}",
                    "check_in": "${data.check_in}",
                    "check_out": "${data.check_out}",
                    "adults": "${data.adults}",
                    "children": "${data.children}",
                    "infants": "${data.infants}",
                    "pets": "${data.pets}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "PROPERTY_DETAILS",
      "title": "Property details",
      "data": {
        "property_id": { "type": "string", "__example__": "1" },
        "property_name": { "type": "string", "__example__": "Kezoi Stays Manikonda" },
