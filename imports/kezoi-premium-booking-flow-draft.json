      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "${data.property_name}" },
          { "type": "TextBody", "text": "${data.nights} nights • ${data.check_in} to ${data.check_out}" },
          { "type": "TextSubheading", "text": "Price Breakdown" },
          { "type": "TextBody", "text": "Stay (${data.nights} nights): ${data.currency} ${data.base_amount}\nExtra guest charges: ${data.currency} ${data.extra_guest_amount}\nTaxable amount: ${data.currency} ${data.taxable_amount}\nGST (${data.gst_rate}%): ${data.currency} ${data.gst_amount}\n  • CGST: ${data.currency} ${data.cgst_amount}\n  • SGST: ${data.currency} ${data.sgst_amount}" },
          { "type": "TextHeading", "text": "Total: ${data.currency} ${data.total_amount}" },
          { "type": "TextCaption", "text": "Live quote calculated on ${data.quote_generated_at}. Availability and prices are verified again before enquiry creation." },
          { "type": "TextBody", "text": "${data.error_message}", "visible": "${data.has_error}" },
          {
            "type": "Footer",
            "label": "Continue to guest details",
