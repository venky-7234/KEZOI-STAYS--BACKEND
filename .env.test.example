# Copy this file to .env.test and use TEST-ONLY infrastructure.
# Never put production database or production provider credentials here.
NODE_ENV=test
PORT=5001

DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Use unique test secrets. Do not reuse production values.
JWT_SECRET=
N8N_SERVICE_TOKEN=
N8N_WEBHOOK_SIGNING_SECRET=

# Use fake invoice identity values in tests.
DEFAULT_CURRENCY=INR
DEFAULT_GST_RATE=18
GST_LEGAL_NAME=TEST BUSINESS
GSTIN=00AAAAA0000A0AA
GST_REGISTERED_ADDRESS=TEST ADDRESS

# Email OTP tests should use a sandbox/test Resend account.
RESEND_API_KEY=
EMAIL_FROM=

# Website page that will collect the mandatory identity document.
WEBSITE_APPLICATION_URL=

# Add these when the Meta Flow encrypted endpoint is tested.
META_APP_SECRET=
META_FLOW_PRIVATE_KEY=
META_FLOW_PRIVATE_KEY_PASSPHRASE=
